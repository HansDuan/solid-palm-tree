# 腾讯混元（合规唯一选项）——复制为 `.env.local` 后填写
# 快捷方式：npm run key -- <你的Key>   （自动写入并做格式校验）

# 有值时走真实模型；为空自动降级 MOCK（规则模拟），全链路照样跑通
HUNYUAN_API_KEY=

# 混元旧平台 2026-08-30 已下线，统一走 TokenHub 网关
# ⚠️ 关键：TokenHub 网关用 `tokenhub.tencentmaas.com` 域名 + `x-api-key` 鉴权头（不是老端点的 Bearer）
# 文档：https://tencentcloud.com/zh/document/product/1300/80632
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 混元系模型（TokenHub 模型广场确认存在；比赛合规只准混元）
# ⚠️ 2026-09 实测：hy4-preview 无法稳定产出 JSON（见 对接契约 §0.1），文本模型固定用 hy3
HUNYUAN_TEXT_MODEL=hy3
# 图片识别（多模态）模型；hy-vision-2.0-instruct 或 hunyuan-t1-vision-20250916 均可
HUNYUAN_VISION_MODEL=hy-vision-2.0-instruct

# ── 稳定性参数（演示现场建议保持默认；出问题再调） ──
# 文本/视觉超时都放宽到 120s，避免误判超时重试
HUNYUAN_TIMEOUT_MS=120000
HUNYUAN_VISION_TIMEOUT_MS=120000
# 网络错误 / 5xx / 429 自动重试次数
HUNYUAN_MAX_RETRY=2

# 批量批改并发与单份重试次数
GRADE_CONCURRENCY=3
GRADE_MAX_ATTEMPTS=2

# ── 图片与内存（OOM 防线） ──
# 单张上传上限（字节）
IMAGE_MAX_BYTES=12582912
# 服务端预处理目标长边（px）——超过会自动缩放
IMAGE_MAX_EDGE=1600
# 一次最多处理的文件数（多页作业）
MAX_PAGES=6
# 视觉转录并发（太高易 429 / 内存吃紧）
OCR_CONCURRENCY=2
# 堆内存预算（MB），预检超 90% 就拒绝并提示减量
MAX_HEAP_MB=1024

# ⚠️ 严禁把填写好的 .env.local 提交到 Git（公开仓库泄 Key = 硬伤）
